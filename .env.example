# Copy to .env and configure production secrets before deployment.
# Never commit .env or expose its values.

# The Go application refuses to start unless this is explicitly "production".
APP_ENV=production

# Required secrets: generate distinct random values of at least 32 characters.
# Example: openssl rand -hex 32
CSRF_SECRET=
DEVICE_TOKEN=
FACE_SERVICE_TOKEN=

# First administrator is created only when no active administrator exists.
# Password must contain at least 12 characters. Remove these after bootstrap.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
# Optional initial lecturer account.
# BOOTSTRAP_LECTURER_USERNAME=
# BOOTSTRAP_LECTURER_PASSWORD=
# BOOTSTRAP_LECTURER_CLASSES=IK24-A,IK24-B

# Production MongoDB connection. Use authentication and TLS for remote hosts.
MONGODB_URI=
MONGODB_DATABASE=attendance

# Internal Python face service; its FACE_SERVICE_TOKEN must match this value.
FACE_SERVICE_URL=http://127.0.0.1:8000
FACE_SIM_THRESHOLD=0.45
FACE_POSE_THRESHOLD=0.30
SCAN_MIN_MATCH_FRAMES=2
FACE_SERVICE_TIMEOUT_SECONDS=15

# Face service Docker Compose port binding. Keep loopback when Go runs locally.
# On separate hosts, use a private address and firewall rules permitting Go only.
FACE_SERVICE_BIND_ADDRESS=127.0.0.1

# Optional private S3-compatible storage (Garage). Leave all S3_* empty to disable.
S3_ENDPOINT=
S3_REGION=garage
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
IMAGE_RETENTION_DAYS=30
IMAGE_REVIEW_RETENTION_DAYS=90

# Optional Go server paths and listen address.
# HTTP_ADDR=:8080
# STATIC_DIR=static
# VIEW_DIR=views
